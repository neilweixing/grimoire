{
  "name": "grimoire-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Grimoire \u2014 Spells written in code",
  "author": "Grimoire",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node --check src/main.cjs && node --check src/clipboard.cjs && node --check src/app-controls.cjs && node --check src/data-directory.cjs && node --check src/preload.cjs && node --check scripts/dev.mjs && node --check src/embedded-browser.cjs && node --check src/browser-preferences.cjs && node --check src/browser-tools.cjs && node --check scripts/icon.mjs && node --check scripts/stage.mjs && node --check scripts/smoke.mjs && node --check src/updater.cjs && node --check src/browser-sessions.cjs && node --check scripts/browser-smoke.cjs && node --check scripts/verify-updates.mjs && node --check scripts/build-installer.mjs",
    "start": "electron .",
    "dist": "pnpm run stage && node scripts/build-installer.mjs --mac dmg zip --arm64 --publish never",
    "pack": "pnpm run stage && node scripts/build-installer.mjs --mac --arm64 --dir --publish never",
    "stage": "node scripts/stage.mjs",
    "dev:desktop": "node scripts/dev.mjs",
    "dist:msi": "pnpm run stage && node scripts/build-installer.mjs --win msi --x64 --publish never",
    "pack:win": "pnpm run stage && node scripts/build-installer.mjs --win --x64 --dir --publish never",
    "smoke": "node scripts/smoke.mjs",
    "dist:win": "pnpm run stage && node scripts/build-installer.mjs --win msi nsis --x64 --publish never",
    "browser:smoke": "electron scripts/browser-smoke.cjs",
    "verify:updates": "node scripts/verify-updates.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.grimoire.desktop",
    "productName": "Grimoire",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "src/main.cjs",
      "src/clipboard.cjs",
      "src/app-controls.cjs",
      "src/data-directory.cjs",
      "src/preload.cjs",
      "package.json",
      "src/embedded-browser.cjs",
      "src/browser-preferences.cjs",
      "src/browser-tools.cjs",
      "src/updater.cjs",
      "src/browser-sessions.cjs"
    ],
    "extraResources": [
      {
        "from": "stage/agent",
        "to": "agent",
        "filter": [
          "dist/**/*",
          "package.json"
        ]
      },
      {
        "from": "stage/agent/node_modules",
        "to": "agent/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "stage/web",
        "to": "web"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "Grimoire",
      "sign": false,
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "Grimoire-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "neilweixing",
        "repo": "grimoire",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "artifactName": "Grimoire-${version}-${arch}-setup.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
