# Optional. Configure model providers and API keys in Settings > Providers.
PORT=3001
# Defaults to .data/providers.json at the repository root. An absolute path can override it.
# GRIMOIRE_SETTINGS_FILE=/absolute/path/to/providers.json
# Initial default workspace folder. Existing registrations are preserved; add more folders in the sidebar.
# GRIMOIRE_WORKSPACE=/absolute/path/to/project
# Enables the Full access option. Each chat still requires explicit acknowledgement.
GRIMOIRE_ALLOW_FULL_ACCESS=false
